COMPOSE_PROJECT_NAME=ferrix-nmfairus
POSTGRES_DB=ferrix_nmfairus
POSTGRES_PORT=5433
FERRIX_WEB_PORT=5173
DATABASE_URL=postgres://ferrix:ferrix@127.0.0.1:5433/ferrix_nmfairus
FERRIX_BIND=127.0.0.1:8080
RUST_LOG=ferrix_api=info,tower_http=info
# Optional: Docker socket override (e.g. unix:///Users/you/.orbstack/run/docker.sock)
# DOCKER_HOST=unix:///var/run/docker.sock


# Run setup-dev.py for fresh installations; existing environments must generate unique keys.
FERRIX_AUTH_ORIGIN=http://127.0.0.1:5173
FERRIX_AUTH_KEY=
