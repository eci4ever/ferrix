{
    on_demand_tls {
        ask http://ferrix:8081/_ferrix/tls-ask
    }
    servers {
        strict_sni_host on
    }
}

{$FERRIX_DOMAIN} {
    encode zstd gzip
    reverse_proxy ferrix:8080
}

https:// {
    tls {
        on_demand
    }
    encode zstd gzip
    @private path /_ferrix /_ferrix/*
    respond @private 404
    reverse_proxy ferrix:8081
}
